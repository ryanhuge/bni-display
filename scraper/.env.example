# BNI Connect 登入
BNI_USERNAME=your_email@example.com
BNI_PASSWORD=your_password
BNI_ORG_ID=12962
BNI_REGION_ID=7700
BNI_COUNTRY_ID=7699

# Email 通知
NOTIFY_EMAIL_TO=your_email@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Supabase（可選）
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# 系統連結（Email 通知中附上的連結）
DISPLAY_URL=http://localhost:4173

# 排程 (cron 格式：每週二中午 12:00)
CRON_SCHEDULE=0 12 * * 2

# 半年期週數（用於計算紅綠燈平均值）
HALF_YEAR_WEEKS=26
